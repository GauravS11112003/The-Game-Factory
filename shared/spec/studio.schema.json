    "StudioEdit": {
      "additionalProperties": false,
      "description": "One change the copilot proposes. `target` is an object id, a rule/behaviour owner, or null for game level.\n`data` is shaped by the action (CONTRACTS_V6 §5.2). The client applies edits as one undoable step.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "action": {
          "enum": [
            "set_world",
            "set_theme",
            "set_hud",
            "set_title",
            "add_scene",
            "update_object",
            "delete_object",
