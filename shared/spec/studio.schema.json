        },
        "params": {
          "additionalProperties": true,
          "type": "object"
        },
        "off": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "BehaviorDef",
      "type": "object"
    },
    "CameraDef": {
