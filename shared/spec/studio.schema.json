    "Condition": {
      "additionalProperties": false,
      "description": "`subject` is \"self\", \"game\", \"other\" (the object an event involved) or an object id.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "subject": {
          "default": "self",
