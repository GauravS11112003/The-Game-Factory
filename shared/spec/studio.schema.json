{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/studio.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/studio.py by scripts/gen_contracts.py; do not edit.",
  "title": "studio",
