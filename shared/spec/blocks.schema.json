        "radius": {
          "default": 1.0,
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/Dir",
          "default": "none"
        },
        "cells": {
          "default": 0,
          "type": "number"
        },
        "speed": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSaw",
      "type": "object"
    },
    "BSpring": {
      "additionalProperties": false,
