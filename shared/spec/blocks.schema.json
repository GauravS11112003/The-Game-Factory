        },
        "author_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/BlockRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
