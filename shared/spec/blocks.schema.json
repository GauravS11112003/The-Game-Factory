        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "zone",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/ZoneEffect"
        },
        "dir": {
          "$ref": "#/$defs/Dir4",
          "default": "right"
