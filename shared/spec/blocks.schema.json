    "BMove": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "move",
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/Dir4"
        },
        "cells": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "mode": {
          "default": "pingpong",
          "enum": [
            "pingpong",
            "loop"
          ],
          "type": "string"
        },
        "wait_s": {
          "default": 0.3,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dir",
        "cells",
        "speed"
      ],
      "title": "BMove",
      "type": "object"
    },
    "BNpc": {
      "additionalProperties": false,
      "description": "A character that talks: touching it shows its lines one by one in a speech bubble.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "npc",
          "type": "string"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "lines"
      ],
      "title": "BNpc",
      "type": "object"
    },
    "BPickup": {
      "additionalProperties": false,
      "description": "Something to collect. `item` names it for rules (\"star\"); `effect` is a ready-made rule fired on collect.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "pickup",
          "type": "string"
        },
        "item": {
          "default": "star",
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PickupEffect",
          "default": "none"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 5.0
        },
        "respawn_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPickup",
      "type": "object"
    },
    "BPortal": {
      "additionalProperties": false,
      "description": "Touching a portal moves the player to its partner: the other portal with the same `pair` label in the level\n(a lone portal does nothing).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "portal",
          "type": "string"
        },
        "pair": {
          "default": "a",
          "pattern": "^[a-z0-9]{1,8}$",
          "type": "string"
