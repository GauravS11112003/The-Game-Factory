{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/blocks.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/blocks.py by scripts/gen_contracts.py; do not edit.",
  "title": "blocks",
  "description": "Blocks: the public, cross-game library (docs/v4/CONTRACTS_V4.md §5).",
  "$ref": "#/$defs/Block",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "BCrumble": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "crumble",
          "type": "string"
        },
        "delay_s": {
          "default": 0.5,
          "type": "number"
        },
        "respawn_s": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BCrumble",
      "type": "object"
    },
    "BEnemy": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "enemy",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EnemyParams"
        }
      },
      "required": [
        "kind",
        "archetype"
      ],
      "title": "BEnemy",
      "type": "object"
    },
    "BFalling": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "falling",
          "type": "string"
        },
        "delay_s": {
          "default": 0.4,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFalling",
      "type": "object"
    },
    "BFirebar": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "firebar",
          "type": "string"
        },
        "balls": {
          "default": 4,
          "maximum": 6,
          "minimum": 3,
          "type": "integer"
        },
        "speed_deg_s": {
          "default": 90,
          "type": "number"
        },
        "phase": {
          "default": 0,
          "type": "number"
        }
