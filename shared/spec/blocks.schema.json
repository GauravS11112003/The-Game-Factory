        "strength": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "effect"
      ],
      "title": "BZone",
      "type": "object"
    },
    "Behavior": {
      "discriminator": {
        "mapping": {
          "crumble": "#/$defs/BCrumble",
          "enemy": "#/$defs/BEnemy",
          "falling": "#/$defs/BFalling",
          "firebar": "#/$defs/BFirebar",
          "move": "#/$defs/BMove",
          "npc": "#/$defs/BNpc",
          "pickup": "#/$defs/BPickup",
          "portal": "#/$defs/BPortal",
          "saw": "#/$defs/BSaw",
          "spring": "#/$defs/BSpring",
          "static": "#/$defs/BStatic",
          "zone": "#/$defs/BZone"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BStatic"
        },
        {
          "$ref": "#/$defs/BEnemy"
        },
        {
          "$ref": "#/$defs/BMove"
        },
        {
          "$ref": "#/$defs/BSpring"
        },
        {
          "$ref": "#/$defs/BCrumble"
        },
        {
          "$ref": "#/$defs/BFalling"
        },
        {
          "$ref": "#/$defs/BSaw"
        },
        {
          "$ref": "#/$defs/BFirebar"
        },
        {
          "$ref": "#/$defs/BPortal"
        },
        {
          "$ref": "#/$defs/BZone"
        },
        {
          "$ref": "#/$defs/BPickup"
        },
        {
          "$ref": "#/$defs/BNpc"
        }
      ]
    },
    "Block": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "pattern": "^blk_[a-z0-9]{8}$",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "maxLength": 24,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/BlockKind"
        },
        "behavior": {
          "anyOf": [
            {
              "$ref": "#/$defs/Behavior"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "collision": {
          "default": "none",
          "enum": [
            "solid",
            "one_way",
            "none"
          ],
          "type": "string"
        },
        "art": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibraryArt"
            },
            {
              "type": "null"
            }
          ],
          "default": null
