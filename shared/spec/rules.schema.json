{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/rules.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/rules.py by scripts/gen_contracts.py; do not edit.",
  "title": "rules",
  "description": "GameRules: the game-wide rules sheet; each level stores the resolved snapshot (PLAN_V2 §8.2).",
  "$ref": "#/$defs/GameRules",
  "$defs": {
    "Abilities": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "run": {
          "default": true,
          "type": "boolean"
        },
        "stomp": {
          "default": true,
          "type": "boolean"
        },
        "double_jump": {
          "default": false,
          "type": "boolean"
        },
        "fast_fall": {
          "default": true,
          "type": "boolean"
        }
      },
      "title": "Abilities",
      "type": "object"
    },
    "CellXY": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "ChallengeBand": {
      "enum": [
        "normal",
        "hard"
      ],
      "type": "string"
    },
    "Dial": {
      "enum": [
        "faithful",
        "polished",
        "challenging"
      ],
      "type": "string"
    },
    "DoCounter": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "add_counter",
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "n": {
          "default": 1,
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DoCounter",
      "type": "object"
    },
    "DoFlipGravity": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "flip_gravity",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoFlipGravity",
      "type": "object"
    },
    "DoFreeze": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "freeze_enemies",
          "type": "string"
        },
        "seconds": {
          "exclusiveMinimum": 0,
          "maximum": 60,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "seconds"
      ],
      "title": "DoFreeze",
      "type": "object"
    },
    "DoGravity": {
      "additionalProperties": false,
      "description": "Scale gravity (0.5 = moon jumps).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "gravity",
          "type": "string"
        },
        "times": {
          "maximum": 2,
          "minimum": 0.25,
          "type": "number"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "times"
      ],
      "title": "DoGravity",
      "type": "object"
    },
    "DoHeal": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "heal",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoHeal",
      "type": "object"
    },
    "DoHurt": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "hurt",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoHurt",
      "type": "object"
    },
    "DoJumpPower": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "jump_power",
          "type": "string"
        },
        "times": {
          "maximum": 2,
          "minimum": 0.5,
          "type": "number"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "times"
      ],
      "title": "DoJumpPower",
      "type": "object"
    },
    "DoLose": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "lose",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoLose",
      "type": "object"
    },
    "DoOpen": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "open",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoOpen",
      "type": "object"
    },
    "DoPush": {
      "additionalProperties": false,
      "description": "v5: give a physics body a push (cells/s added to its velocity).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "push",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "vx": {
          "default": 0,
          "maximum": 30,
          "minimum": -30,
          "type": "number"
        },
        "vy": {
          "default": 0,
          "maximum": 30,
          "minimum": -30,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoPush",
      "type": "object"
    },
    "DoReverse": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "reverse_controls",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoReverse",
      "type": "object"
    },
    "DoSay": {
      "additionalProperties": false,
      "description": "A speech bubble over the player (or over `target`) for `seconds`.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "say",
          "type": "string"
        },
        "text": {
          "maxLength": 90,
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "seconds": {
          "default": 3,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "DoSay",
      "type": "object"
    },
    "DoScore": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "add_score",
          "type": "string"
        },
        "n": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "n"
      ],
      "title": "DoScore",
      "type": "object"
    },
    "DoSetFrame": {
      "additionalProperties": false,
      "description": "v5: jump a flipbook entity to frame `frame`.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "set_frame",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "frame": {
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "target",
        "frame"
      ],
      "title": "DoSetFrame",
      "type": "object"
    },
    "DoShake": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "shake",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoShake",
      "type": "object"
    },
    "DoSound": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "sound",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/SoundName"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DoSound",
      "type": "object"
    },
    "DoSpeed": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "speed",
          "type": "string"
        },
        "times": {
          "maximum": 3,
          "minimum": 0.25,
          "type": "number"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "times"
      ],
      "title": "DoSpeed",
      "type": "object"
    },
    "DoTeleport": {
      "additionalProperties": false,
      "description": "Move the player to a cell (to) or onto an entity (target). Exactly one is set.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "teleport",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellXY"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoTeleport",
      "type": "object"
    },
    "DoToggle": {
      "additionalProperties": false,
      "description": "Show or hide an entity: a hidden entity is not drawn, not solid and does nothing.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "toggle",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "to": {
          "default": "flip",
          "enum": [
            "on",
            "off",
            "flip"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoToggle",
      "type": "object"
    },
    "DoWin": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "win",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoWin",
      "type": "object"
    },
    "GameMode": {
      "enum": [
        "platformer",
        "topdown",
        "runner",
        "flappy"
      ],
      "type": "string"
    },
    "GameRules": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "physics_profile": {
          "$ref": "#/$defs/ProfileId",
          "default": "v2-standard"
        },
        "profile_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "abilities": {
          "$ref": "#/$defs/Abilities"
        },
        "lives": {
          "default": "off",
          "enum": [
            "off",
            3,
            5
          ]
        },
        "hearts": {
          "default": 1,
          "maximum": 3,
          "minimum": 1,
          "type": "integer"
        },
        "theme": {
          "$ref": "#/$defs/Theme",
          "default": "sketchbook"
        },
        "music": {
          "default": true,
          "type": "boolean"
        },
        "timer_pressure": {
          "default": false,
          "type": "boolean"
        },
        "camera": {
          "default": "follow",
          "enum": [
            "follow",
            "no_backscroll"
          ],
          "type": "string"
        },
        "default_dial": {
          "$ref": "#/$defs/Dial",
          "default": "polished"
        },
        "default_band": {
          "$ref": "#/$defs/ChallengeBand",
          "default": "normal"
        },
        "player_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/GameMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "logic": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RuleV4"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "version"
      ],
      "title": "GameRules",
      "type": "object"
    },
    "ProfileId": {
      "enum": [
        "v2-standard",
        "v2-gentle",
        "v2-snappy",
        "v1-classic"
      ],
      "type": "string"
    },
    "RectCells": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "RuleDo": {
      "discriminator": {
        "mapping": {
          "add_counter": "#/$defs/DoCounter",
          "add_score": "#/$defs/DoScore",
          "flip_gravity": "#/$defs/DoFlipGravity",
          "freeze_enemies": "#/$defs/DoFreeze",
          "gravity": "#/$defs/DoGravity",
          "heal": "#/$defs/DoHeal",
          "hurt": "#/$defs/DoHurt",
          "jump_power": "#/$defs/DoJumpPower",
          "lose": "#/$defs/DoLose",
          "open": "#/$defs/DoOpen",
          "push": "#/$defs/DoPush",
          "reverse_controls": "#/$defs/DoReverse",
          "say": "#/$defs/DoSay",
          "set_frame": "#/$defs/DoSetFrame",
          "shake": "#/$defs/DoShake",
          "sound": "#/$defs/DoSound",
          "speed": "#/$defs/DoSpeed",
          "teleport": "#/$defs/DoTeleport",
          "toggle": "#/$defs/DoToggle",
          "win": "#/$defs/DoWin"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/DoFlipGravity"
        },
        {
          "$ref": "#/$defs/DoGravity"
        },
        {
          "$ref": "#/$defs/DoSpeed"
        },
        {
          "$ref": "#/$defs/DoJumpPower"
        },
        {
          "$ref": "#/$defs/DoReverse"
        },
        {
          "$ref": "#/$defs/DoTeleport"
        },
        {
          "$ref": "#/$defs/DoToggle"
        },
        {
          "$ref": "#/$defs/DoOpen"
        },
        {
          "$ref": "#/$defs/DoFreeze"
        },
        {
          "$ref": "#/$defs/DoScore"
        },
        {
          "$ref": "#/$defs/DoCounter"
        },
        {
          "$ref": "#/$defs/DoHeal"
        },
        {
          "$ref": "#/$defs/DoHurt"
        },
        {
          "$ref": "#/$defs/DoWin"
        },
        {
          "$ref": "#/$defs/DoLose"
        },
        {
          "$ref": "#/$defs/DoSay"
        },
        {
          "$ref": "#/$defs/DoSound"
        },
        {
          "$ref": "#/$defs/DoShake"
        },
        {
          "$ref": "#/$defs/DoSetFrame"
        },
        {
          "$ref": "#/$defs/DoPush"
        }
      ]
    },
    "RuleIf": {
      "additionalProperties": false,
      "description": "v5: a condition on a counter (counters double as the inventory: \"keys\", \"red gems\").",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "at_least": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "below": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "title": "RuleIf",
      "type": "object"
    },
    "RuleKey": {
      "enum": [
        "space",
        "action"
      ],
      "type": "string"
    },
    "RuleV4": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "when": {
          "$ref": "#/$defs/RuleWhen"
        },
        "then": {
          "items": {
            "$ref": "#/$defs/RuleDo"
          },
          "maxItems": 4,
          "minItems": 1,
          "type": "array"
        },
        "once": {
          "default": false,
          "type": "boolean"
        },
        "off": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "only_if": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/RuleIf"
              },
              "maxItems": 3,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "when",
        "then"
      ],
      "title": "RuleV4",
      "type": "object"
    },
    "RuleWhen": {
      "discriminator": {
        "mapping": {
          "all_coins": "#/$defs/WhenAllCoins",
          "choice": "#/$defs/WhenChoice",
          "collect": "#/$defs/WhenCollect",
          "counter": "#/$defs/WhenCounter",
          "frame": "#/$defs/WhenFrame",
          "key": "#/$defs/WhenKey",
          "score": "#/$defs/WhenScore",
          "start": "#/$defs/WhenStart",
          "timer": "#/$defs/WhenTimer",
          "touch": "#/$defs/WhenTouch",
          "zone": "#/$defs/WhenZone"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/WhenStart"
        },
        {
          "$ref": "#/$defs/WhenKey"
        },
        {
          "$ref": "#/$defs/WhenTouch"
        },
        {
          "$ref": "#/$defs/WhenCollect"
        },
        {
          "$ref": "#/$defs/WhenAllCoins"
        },
        {
          "$ref": "#/$defs/WhenTimer"
        },
        {
          "$ref": "#/$defs/WhenZone"
        },
        {
          "$ref": "#/$defs/WhenScore"
        },
        {
          "$ref": "#/$defs/WhenCounter"
        },
        {
          "$ref": "#/$defs/WhenFrame"
        },
        {
          "$ref": "#/$defs/WhenChoice"
        }
      ]
    },
    "SoundName": {
      "enum": [
        "ding",
        "boing",
        "zap",
        "whoosh",
        "boom",
        "fanfare"
      ],
      "type": "string"
    },
    "Theme": {
      "enum": [
        "sketchbook",
        "notebook",
        "graph",
        "kraft"
      ],
      "type": "string"
    },
    "WhenAllCoins": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "all_coins",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "WhenAllCoins",
      "type": "object"
    },
    "WhenChoice": {
      "additionalProperties": false,
      "description": "v5: the player picks choice `index` (0-based) in a talking character's choices.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "choice",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "index": {
          "maximum": 3,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "target",
        "index"
      ],
      "title": "WhenChoice",
      "type": "object"
    },
    "WhenCollect": {
      "additionalProperties": false,
