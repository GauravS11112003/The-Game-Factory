      "type": "string"
    },
    "StampKind": {
      "enum": [
        "coin",
        "big_coin",
        "spikes",
        "flag",
        "checkpoint",
        "spring",
        "saw",
        "walker",
        "hopper",
        "flyer",
        "key",
        "door",
        "start",
        "library"
