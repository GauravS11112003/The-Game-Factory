    "Stage": {
      "enum": [
        "ink",
        "understood",
        "designed"
      ],
      "type": "string"
    },
    "StageName": {
      "enum": [
        "upload",
        "cv",
        "ink",
        "perceive",
        "understood",
        "design",
        "designed",
        "refine",
        "critic"
