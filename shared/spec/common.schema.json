      "additionalProperties": false,
      "description": "Level world. w = 48·screens, h = 27 (§2.1, §6.1).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "cell": {
          "const": 16,
          "default": 16,
          "type": "integer"
        },
        "screens": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "w": {
          "maximum": 288,
          "minimum": 48,
          "type": "integer"
        },
        "h": {
          "const": 27,
          "default": 27,
          "type": "integer"
        }
      },
      "required": [
        "screens",
        "w"
      ],
      "title": "World",
      "type": "object"
    }
