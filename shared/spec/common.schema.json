{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/common.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/common.py by scripts/gen_contracts.py; do not edit.",
  "title": "common",
  "description": "Shared primitives of the dal-level v2 contracts (PLAN_V2 §2.1, §3, §11.3a).",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "Band": {
      "enum": [
        "trivial",
        "easy",
        "normal",
        "hard",
        "expert"
      ],
      "type": "string"
    },
    "CallKind": {
      "enum": [
        "perceive",
        "design",
        "refine",
        "critic",
        "plan",
        "creature",
        "moderate",
        "look"
      ],
      "type": "string"
    },
    "CellXY": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "ChallengeBand": {
      "enum": [
        "normal",
        "hard"
      ],
      "type": "string"
    },
    "Collision": {
      "enum": [
        "solid",
        "one_way",
        "none",
        "hazard",
        "trigger"
