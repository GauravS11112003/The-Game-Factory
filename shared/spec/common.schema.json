    },
    "DifficultyWish": {
      "enum": [
        "none",
        "easy",
        "normal",
        "hard"
      ],
      "type": "string"
    },
    "Dir": {
      "enum": [
        "up",
        "down",
        "left",
        "right",
        "none"
      ],
      "type": "string"
    },
    "Dir4": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "type": "string"
    },
    "Face": {
      "enum": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "type": "string"
    },
    "InkColor": {
      "enum": [
        "black",
        "red",
        "green",
        "blue",
        "pencil",
        "draft"
      ],
      "type": "string"
    },
    "InkWorld": {
      "additionalProperties": false,
      "description": "InkDoc world (§3.2): the same as World without the cell size.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "screens": {
          "maximum": 6,
          "minimum": 1,
          "type": "integer"
        },
        "w": {
          "maximum": 288,
          "minimum": 48,
          "type": "integer"
        },
        "h": {
          "const": 27,
          "default": 27,
          "type": "integer"
        }
      },
      "required": [
        "screens",
        "w"
      ],
      "title": "InkWorld",
      "type": "object"
    },
    "LibRef": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "type_id": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "type_id",
        "version"
      ],
      "title": "LibRef",
      "type": "object"
    },
    "LlmMode": {
      "enum": [
        "live",
        "fake",
        "off"
      ],
      "type": "string"
    },
    "MessageArgs": {
      "additionalProperties": {
        "$ref": "#/$defs/Scalar"
      },
      "type": "object"
    },
    "MessageRef": {
      "additionalProperties": false,
      "description": "A kid-facing sentence by key (shared/spec/messages.json); raw codes never reach the DOM.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "key": {
          "type": "string"
        },
        "args": {
          "$ref": "#/$defs/MessageArgs"
        }
      },
      "required": [
        "key"
      ],
      "title": "MessageRef",
      "type": "object"
    },
