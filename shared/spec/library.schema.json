{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/library.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/library.py by scripts/gen_contracts.py; do not edit.",
  "title": "library",
  "description": "Object library per game: immutable per version; levels pin {type_id, version} (PLAN_V2 §8.1).",
  "$ref": "#/$defs/LibraryType",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "BCrumble": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "crumble",
          "type": "string"
        },
        "delay_s": {
          "default": 0.5,
          "type": "number"
        },
        "respawn_s": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BCrumble",
      "type": "object"
    },
    "BEnemy": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "enemy",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EnemyParams"
        }
      },
      "required": [
        "kind",
        "archetype"
      ],
      "title": "BEnemy",
      "type": "object"
    },
    "BFalling": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "falling",
          "type": "string"
        },
        "delay_s": {
          "default": 0.4,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFalling",
      "type": "object"
    },
    "BFirebar": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "firebar",
          "type": "string"
        },
        "balls": {
          "default": 4,
          "maximum": 6,
          "minimum": 3,
          "type": "integer"
        },
        "speed_deg_s": {
          "default": 90,
          "type": "number"
        },
        "phase": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFirebar",
      "type": "object"
    },
    "BMove": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "move",
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/Dir4"
        },
        "cells": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "mode": {
          "default": "pingpong",
          "enum": [
            "pingpong",
            "loop"
          ],
          "type": "string"
        },
        "wait_s": {
          "default": 0.3,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dir",
        "cells",
        "speed"
      ],
      "title": "BMove",
      "type": "object"
    },
    "BSaw": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "saw",
          "type": "string"
        },
        "radius": {
          "default": 1.0,
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/Dir",
          "default": "none"
        },
        "cells": {
          "default": 0,
          "type": "number"
        },
        "speed": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSaw",
      "type": "object"
    },
    "BSpring": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "spring",
          "type": "string"
        },
        "dir": {
          "default": "up",
          "enum": [
            "up",
            "left",
            "right"
          ],
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.4,
          "minimum": 0.6,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSpring",
      "type": "object"
    },
    "BStatic": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "static",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BStatic",
      "type": "object"
    },
    "Behavior": {
      "discriminator": {
        "mapping": {
          "crumble": "#/$defs/BCrumble",
          "enemy": "#/$defs/BEnemy",
          "falling": "#/$defs/BFalling",
          "firebar": "#/$defs/BFirebar",
          "move": "#/$defs/BMove",
          "saw": "#/$defs/BSaw",
          "spring": "#/$defs/BSpring",
          "static": "#/$defs/BStatic"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BStatic"
        },
        {
          "$ref": "#/$defs/BEnemy"
        },
        {
          "$ref": "#/$defs/BMove"
        },
        {
          "$ref": "#/$defs/BSpring"
        },
        {
          "$ref": "#/$defs/BCrumble"
        },
        {
          "$ref": "#/$defs/BFalling"
        },
        {
          "$ref": "#/$defs/BSaw"
        },
        {
          "$ref": "#/$defs/BFirebar"
        }
      ]
    },
    "CellXY": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "Dir": {
      "enum": [
        "up",
        "down",
        "left",
        "right",
        "none"
      ],
      "type": "string"
    },
    "Dir4": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "EnemyParams": {
      "additionalProperties": false,
      "description": "Archetype parameters (§5.7); every field optional, defaults live in core/params.ts.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledge_aware": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forward": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "hover",
                "horizontal",
                "vertical",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facing": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "toward_player"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blob_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rise_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EnemyParams",
      "type": "object"
    },
    "InkColor": {
      "enum": [
        "black",
        "red",
        "green",
        "blue",
        "pencil",
        "draft"
      ],
      "type": "string"
    },
    "InkStroke": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/InkColor"
        },
        "kind": {
          "enum": [
            "line",
            "dot",
            "blob"
          ],
          "type": "string"
        },
        "pts": {
          "items": {
            "$ref": "#/$defs/CellXY"
          },
          "type": "array"
        },
        "w": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "closed": {
          "type": "boolean"
        },
        "sheet": {
          "minimum": 0,
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/StampKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Behavior"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lib": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "color",
        "kind",
        "pts",
        "w",
        "closed",
        "sheet",
        "origin"
      ],
      "title": "InkStroke",
      "type": "object"
    },
    "LibRef": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "type_id": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "type_id",
        "version"
      ],
      "title": "LibRef",
      "type": "object"
    },
    "LibraryArt": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "strokes": {
          "items": {
            "$ref": "#/$defs/InkStroke"
          },
          "type": "array"
        },
        "size_cells": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "type": "array"
        },
        "rig": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "strokes",
        "size_cells"
      ],
      "title": "LibraryArt",
      "type": "object"
    },
    "LibrarySymbol": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "samples": {
          "items": {
            "items": {
              "$ref": "#/$defs/InkStroke"
            },
            "type": "array"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "color": {
          "$ref": "#/$defs/InkColor"
        }
      },
      "required": [
        "samples",
        "color"
      ],
      "title": "LibrarySymbol",
      "type": "object"
    },
    "LibraryType": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "game_id": {
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "maxLength": 16,
          "minLength": 1,
          "type": "string"
        },
        "letter": {
          "maxLength": 1,
          "minLength": 1,
          "type": "string"
        },
        "kind": {
          "enum": [
            "creature",
            "platform",
            "hazard",
            "pickup",
            "prop",
            "player"
          ],
          "type": "string"
        },
        "behavior": {
          "$ref": "#/$defs/Behavior"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "collision": {
          "enum": [
            "solid",
            "one_way",
            "none"
          ],
          "type": "string"
        },
        "art": {
          "$ref": "#/$defs/LibraryArt"
        },
        "symbol": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibrarySymbol"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "author": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "game_id",
        "version",
        "name",
        "letter",
        "kind",
        "behavior",
        "collision",
        "art",
        "author",
        "created_at"
      ],
      "title": "LibraryType",
      "type": "object"
    },
    "Origin": {
      "enum": [
        "kid",
        "parent",
        "designer",
        "library",
        "draft",
        "migrated"
      ],
      "type": "string"
    },
    "Rig": {
      "additionalProperties": false,
      "description": "Rig extracted from a creature drawing (§7.6). Parts are stroke ids.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "legs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "arms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "eyes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "synth_legs": {
          "default": false,
          "type": "boolean"
        },
        "hip_y": {
          "default": 0.7,
          "type": "number"
        }
      },
      "title": "Rig",
      "type": "object"
    },
    "Role": {
      "enum": [
        "ground",
        "platform",
        "wall",
        "ceiling",
        "spikes",
        "lava",
        "saw",
        "enemy",
        "coin",
        "big_coin",
        "key",
        "door",
        "spring",
        "checkpoint",
        "goal",
        "pole",
        "start_marker",
        "text",
        "arrow",
        "decoration",
        "library_tag",
        "unknown"
      ],
      "type": "string"
    },
    "StampKind": {
      "enum": [
        "coin",
        "big_coin",
        "spikes",
        "flag",
        "checkpoint",
        "spring",
        "saw",
        "walker",
        "hopper",
        "flyer",
        "key",
        "door",
        "start",
        "library"
      ],
      "type": "string"
    }
  }
}
