{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/behavior.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/behavior.py by scripts/gen_contracts.py; do not edit.",
  "title": "behavior",
  "description": "Behavior: the typed union a kid chip, a perception binding, a library type or U4 `bind` attaches",
  "$ref": "#/$defs/Behavior",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "BCrumble": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "crumble",
          "type": "string"
        },
        "delay_s": {
          "default": 0.5,
          "type": "number"
        },
        "respawn_s": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BCrumble",
      "type": "object"
    },
    "BEnemy": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "enemy",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EnemyParams"
        }
      },
      "required": [
        "kind",
        "archetype"
      ],
      "title": "BEnemy",
      "type": "object"
    },
    "BFalling": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "falling",
          "type": "string"
        },
        "delay_s": {
          "default": 0.4,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFalling",
      "type": "object"
    },
    "BFirebar": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "firebar",
          "type": "string"
        },
        "balls": {
          "default": 4,
          "maximum": 6,
          "minimum": 3,
          "type": "integer"
        },
        "speed_deg_s": {
          "default": 90,
          "type": "number"
        },
        "phase": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFirebar",
      "type": "object"
    },
    "BMove": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "move",
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/Dir4"
        },
        "cells": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "mode": {
          "default": "pingpong",
          "enum": [
            "pingpong",
            "loop"
          ],
          "type": "string"
        },
        "wait_s": {
          "default": 0.3,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dir",
        "cells",
        "speed"
      ],
      "title": "BMove",
      "type": "object"
    },
    "BSaw": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "saw",
          "type": "string"
        },
        "radius": {
          "default": 1.0,
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/Dir",
          "default": "none"
        },
        "cells": {
          "default": 0,
          "type": "number"
        },
        "speed": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSaw",
      "type": "object"
    },
    "BSpring": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "spring",
          "type": "string"
        },
        "dir": {
          "default": "up",
          "enum": [
            "up",
            "left",
            "right"
          ],
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.4,
          "minimum": 0.6,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSpring",
      "type": "object"
    },
    "BStatic": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "static",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BStatic",
      "type": "object"
    },
    "Behavior": {
      "discriminator": {
        "mapping": {
          "crumble": "#/$defs/BCrumble",
          "enemy": "#/$defs/BEnemy",
          "falling": "#/$defs/BFalling",
          "firebar": "#/$defs/BFirebar",
          "move": "#/$defs/BMove",
          "saw": "#/$defs/BSaw",
          "spring": "#/$defs/BSpring",
          "static": "#/$defs/BStatic"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BStatic"
        },
        {
          "$ref": "#/$defs/BEnemy"
        },
        {
          "$ref": "#/$defs/BMove"
        },
        {
          "$ref": "#/$defs/BSpring"
        },
        {
          "$ref": "#/$defs/BCrumble"
        },
        {
          "$ref": "#/$defs/BFalling"
        },
        {
          "$ref": "#/$defs/BSaw"
        },
        {
          "$ref": "#/$defs/BFirebar"
        }
      ]
    },
    "Dir": {
      "enum": [
        "up",
        "down",
        "left",
        "right",
        "none"
      ],
      "type": "string"
    },
    "Dir4": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "EnemyParams": {
      "additionalProperties": false,
      "description": "Archetype parameters (§5.7); every field optional, defaults live in core/params.ts.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledge_aware": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forward": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "hover",
                "horizontal",
                "vertical",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facing": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "toward_player"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blob_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rise_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EnemyParams",
      "type": "object"
    }
  }
}
