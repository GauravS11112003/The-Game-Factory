{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/behavior.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/behavior.py by scripts/gen_contracts.py; do not edit.",
  "title": "behavior",
  "description": "Behavior: the typed union a kid chip, a perception binding, a library type or U4 `bind` attaches",
  "$ref": "#/$defs/Behavior",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "BCrumble": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "crumble",
          "type": "string"
        },
        "delay_s": {
          "default": 0.5,
          "type": "number"
        },
        "respawn_s": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BCrumble",
      "type": "object"
    },
    "BEnemy": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "enemy",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EnemyParams"
        }
      },
      "required": [
        "kind",
        "archetype"
      ],
      "title": "BEnemy",
      "type": "object"
    },
    "BFalling": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "falling",
          "type": "string"
        },
        "delay_s": {
          "default": 0.4,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFalling",
      "type": "object"
    },
    "BFirebar": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "firebar",
          "type": "string"
        },
        "balls": {
          "default": 4,
          "maximum": 6,
          "minimum": 3,
          "type": "integer"
        },
        "speed_deg_s": {
          "default": 90,
          "type": "number"
        },
        "phase": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFirebar",
      "type": "object"
    },
    "BFlipbook": {
      "additionalProperties": false,
      "description": "Changes through its drawn frames over time (seed, sprout, flower). The frame art is the library type's frames.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "flipbook",
          "type": "string"
        },
        "frames": {
          "default": 3,
          "maximum": 6,
          "minimum": 2,
          "type": "integer"
        },
        "frame_s": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "type": "number"
        },
        "loop": {
          "default": false,
          "type": "boolean"
        },
        "solid_from": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collect_at": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "item": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9 ]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFlipbook",
      "type": "object"
    },
    "BMove": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "move",
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/Dir4"
        },
        "cells": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "mode": {
          "default": "pingpong",
          "enum": [
            "pingpong",
            "loop"
          ],
          "type": "string"
        },
        "wait_s": {
          "default": 0.3,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dir",
        "cells",
        "speed"
      ],
      "title": "BMove",
      "type": "object"
    },
    "BNpc": {
      "additionalProperties": false,
      "description": "A character that talks: touching it shows its lines one by one in a speech bubble.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "npc",
          "type": "string"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "lines"
      ],
      "title": "BNpc",
      "type": "object"
    },
    "BPhysics": {
      "additionalProperties": false,
      "description": "A loose object that falls, slides, stacks and can be pushed. Boxes stay upright; balls roll.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "physics",
          "type": "string"
        },
        "shape": {
          "default": "box",
          "enum": [
            "box",
            "ball"
          ],
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/Material",
          "default": "wood"
        },
        "fixed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPhysics",
      "type": "object"
    },
    "BPickup": {
      "additionalProperties": false,
      "description": "Something to collect. `item` names it for rules (\"star\"); `effect` is a ready-made rule fired on collect.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "pickup",
          "type": "string"
        },
        "item": {
          "default": "star",
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PickupEffect",
          "default": "none"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 5.0
        },
        "respawn_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPickup",
      "type": "object"
    },
    "BPortal": {
      "additionalProperties": false,
      "description": "Touching a portal moves the player to its partner: the other portal with the same `pair` label in the level\n(a lone portal does nothing).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "portal",
          "type": "string"
        },
        "pair": {
          "default": "a",
          "pattern": "^[a-z0-9]{1,8}$",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPortal",
      "type": "object"
    },
    "BSaw": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "saw",
          "type": "string"
        },
        "radius": {
          "default": 1.0,
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/Dir",
          "default": "none"
        },
        "cells": {
          "default": 0,
          "type": "number"
        },
        "speed": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSaw",
      "type": "object"
    },
    "BScripted": {
      "additionalProperties": false,
      "description": "Runs the library type's script (a developer pack, app/spec/script.py).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "scripted",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BScripted",
      "type": "object"
    },
    "BSpring": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "spring",
          "type": "string"
        },
        "dir": {
          "default": "up",
          "enum": [
            "up",
            "left",
            "right"
          ],
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.4,
          "minimum": 0.6,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSpring",
      "type": "object"
    },
    "BStatic": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "static",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BStatic",
      "type": "object"
    },
    "BZone": {
      "additionalProperties": false,
      "description": "An area with an effect while the player is inside: wind and conveyor push toward `dir`, water slows and lets\nyou swim up, ice is slippery, low_gravity floats, slow halves speed. `strength` scales the effect.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "zone",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/ZoneEffect"
        },
        "dir": {
          "$ref": "#/$defs/Dir4",
          "default": "right"
        },
        "strength": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "effect"
      ],
      "title": "BZone",
      "type": "object"
    },
    "Behavior": {
      "discriminator": {
        "mapping": {
          "crumble": "#/$defs/BCrumble",
          "enemy": "#/$defs/BEnemy",
          "falling": "#/$defs/BFalling",
          "firebar": "#/$defs/BFirebar",
          "flipbook": "#/$defs/BFlipbook",
          "move": "#/$defs/BMove",
          "npc": "#/$defs/BNpc",
          "physics": "#/$defs/BPhysics",
          "pickup": "#/$defs/BPickup",
          "portal": "#/$defs/BPortal",
          "saw": "#/$defs/BSaw",
          "scripted": "#/$defs/BScripted",
          "spring": "#/$defs/BSpring",
          "static": "#/$defs/BStatic",
          "zone": "#/$defs/BZone"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BStatic"
        },
        {
          "$ref": "#/$defs/BEnemy"
        },
        {
          "$ref": "#/$defs/BMove"
        },
        {
          "$ref": "#/$defs/BSpring"
        },
        {
          "$ref": "#/$defs/BCrumble"
        },
        {
          "$ref": "#/$defs/BFalling"
        },
        {
          "$ref": "#/$defs/BSaw"
        },
        {
          "$ref": "#/$defs/BFirebar"
        },
        {
          "$ref": "#/$defs/BPortal"
        },
        {
          "$ref": "#/$defs/BZone"
        },
        {
          "$ref": "#/$defs/BPickup"
        },
        {
          "$ref": "#/$defs/BNpc"
        },
        {
          "$ref": "#/$defs/BPhysics"
        },
        {
          "$ref": "#/$defs/BFlipbook"
        },
        {
          "$ref": "#/$defs/BScripted"
        }
      ]
    },
    "Dir": {
      "enum": [
        "up",
        "down",
        "left",
        "right",
        "none"
      ],
      "type": "string"
    },
    "Dir4": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "EnemyParams": {
      "additionalProperties": false,
      "description": "Archetype parameters (§5.7); every field optional, defaults live in core/params.ts.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledge_aware": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forward": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "hover",
                "horizontal",
                "vertical",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facing": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "toward_player"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blob_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rise_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EnemyParams",
      "type": "object"
    },
    "Material": {
      "enum": [
        "wood",
        "stone",
        "rubber",
        "ice",
        "metal"
      ],
      "type": "string"
    },
    "PickupEffect": {
      "enum": [
        "none",
        "speed",
        "jump",
        "flip",
        "heart",
        "score",
        "freeze",
        "low_gravity"
      ],
      "type": "string"
    },
    "ZoneEffect": {
      "enum": [
        "wind",
        "water",
        "ice",
        "low_gravity",
        "conveyor",
        "slow"
      ],
      "type": "string"
    }
  }
}
