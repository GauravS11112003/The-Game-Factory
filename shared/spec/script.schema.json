        "vx": {
          "default": 0,
          "maximum": 30,
          "minimum": -30,
          "type": "number"
        },
        "vy": {
          "default": 0,
          "maximum": 30,
          "minimum": -30,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoPush",
      "type": "object"
    },
    "DoReverse": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "reverse_controls",
          "type": "string"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoReverse",
      "type": "object"
    },
    "DoSay": {
      "additionalProperties": false,
      "description": "A speech bubble over the player (or over `target`) for `seconds`.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "say",
          "type": "string"
        },
        "text": {
          "maxLength": 90,
          "minLength": 1,
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_]{1,40}$",
              "type": "string"
