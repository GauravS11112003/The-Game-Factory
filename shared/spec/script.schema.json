    "OpGravity": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "gravity",
          "type": "string"
        },
        "on": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpGravity",
      "type": "object"
    },
    "OpHazard": {
      "additionalProperties": false,
      "description": "Touching it hurts the player (on) or not (off).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "hazard",
          "type": "string"
        },
        "on": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpHazard",
      "type": "object"
    },
    "OpHide": {
      "additionalProperties": false,
      "description": "Hidden objects are not drawn and do nothing (their script keeps running).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "hide",
          "type": "string"
        },
        "on": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpHide",
      "type": "object"
    },
    "OpJump": {
      "additionalProperties": false,
      "description": "Jump (only when standing on something, if `gravity` is on).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "jump",
          "type": "string"
        },
        "power": {
          "default": 1.0,
          "maximum": 2.5,
          "minimum": 0.3,
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpJump",
      "type": "object"
    },
    "OpMove": {
      "additionalProperties": false,
      "description": "Set the object's velocity (cells/s; +y is down).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "move",
          "type": "string"
        },
        "vx": {
          "default": 0,
          "maximum": 20,
          "minimum": -20,
          "type": "number"
        },
        "vy": {
          "default": 0,
          "maximum": 20,
          "minimum": -20,
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpMove",
      "type": "object"
    },
    "OpPatrol": {
      "additionalProperties": false,
      "description": "Walk back and forth `range` cells around where the state started.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "patrol",
          "type": "string"
        },
        "speed": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "type": "number"
        },
        "range": {
          "default": 4,
          "exclusiveMinimum": 0,
          "maximum": 40,
          "type": "number"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpPatrol",
      "type": "object"
    },
    "OpSolid": {
      "additionalProperties": false,
      "description": "The player can stand on it (on) or passes through it (off).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "solid",
          "type": "string"
        },
        "on": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpSolid",
      "type": "object"
    },
    "RuleDo": {
      "discriminator": {
        "mapping": {
          "add_counter": "#/$defs/DoCounter",
          "add_score": "#/$defs/DoScore",
          "flip_gravity": "#/$defs/DoFlipGravity",
          "freeze_enemies": "#/$defs/DoFreeze",
          "gravity": "#/$defs/DoGravity",
          "heal": "#/$defs/DoHeal",
          "hurt": "#/$defs/DoHurt",
          "jump_power": "#/$defs/DoJumpPower",
          "lose": "#/$defs/DoLose",
