      "properties": {
        "kind": {
          "const": "win",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoWin",
      "type": "object"
    },
    "OpDo": {
      "additionalProperties": false,
      "description": "Run one rule action (say, sound, add_counter, toggle, win…); `say` without a target speaks from this object.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "do",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/RuleDo"
        }
      },
      "required": [
        "op",
        "action"
      ],
      "title": "OpDo",
      "type": "object"
    },
    "OpFollow": {
      "additionalProperties": false,
      "description": "Move toward the player at `speed` (along x only, or freely in x and y).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "op": {
          "const": "follow",
          "type": "string"
        },
        "speed": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "type": "number"
        },
        "axis": {
          "default": "x",
          "enum": [
            "x",
            "xy"
          ],
          "type": "string"
        }
      },
      "required": [
        "op"
      ],
      "title": "OpFollow",
      "type": "object"
    },
    "OpGoto": {
      "additionalProperties": false,
