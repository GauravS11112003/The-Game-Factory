        "seconds": {
          "default": 3,
          "exclusiveMinimum": 0,
          "maximum": 10,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "text"
      ],
      "title": "DoSay",
      "type": "object"
    },
    "DoScore": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "add_score",
          "type": "string"
        },
        "n": {
          "maximum": 1000,
          "minimum": -1000,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "n"
      ],
      "title": "DoScore",
      "type": "object"
    },
    "DoSetFrame": {
      "additionalProperties": false,
      "description": "v5: jump a flipbook entity to frame `frame`.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "set_frame",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "frame": {
          "maximum": 5,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "target",
        "frame"
      ],
      "title": "DoSetFrame",
      "type": "object"
    },
    "DoShake": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "shake",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoShake",
      "type": "object"
    },
    "DoSound": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "sound",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/SoundName"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DoSound",
      "type": "object"
    },
    "DoSpeed": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "speed",
          "type": "string"
        },
        "times": {
          "maximum": 3,
          "minimum": 0.25,
          "type": "number"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 600,
              "type": "number"
            },
            {
              "type": "null"
            }
