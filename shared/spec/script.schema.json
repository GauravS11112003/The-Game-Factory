          "$ref": "#/$defs/OpMove"
        },
        {
          "$ref": "#/$defs/OpFollow"
        },
        {
          "$ref": "#/$defs/OpPatrol"
        },
        {
          "$ref": "#/$defs/OpJump"
        },
        {
          "$ref": "#/$defs/OpGravity"
        },
        {
          "$ref": "#/$defs/OpSolid"
        },
        {
          "$ref": "#/$defs/OpHazard"
        },
        {
          "$ref": "#/$defs/OpHide"
        },
        {
          "$ref": "#/$defs/OpGoto"
        },
        {
