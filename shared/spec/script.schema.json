    "DoLose": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "lose",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoLose",
      "type": "object"
    },
    "DoOpen": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "open",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoOpen",
      "type": "object"
    },
    "DoPush": {
      "additionalProperties": false,
      "description": "v5: give a physics body a push (cells/s added to its velocity).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "push",
          "type": "string"
