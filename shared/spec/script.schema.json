      "oneOf": [
        {
          "$ref": "#/$defs/DoFlipGravity"
        },
        {
          "$ref": "#/$defs/DoGravity"
        },
        {
          "$ref": "#/$defs/DoSpeed"
        },
        {
          "$ref": "#/$defs/DoJumpPower"
        },
        {
          "$ref": "#/$defs/DoReverse"
        },
        {
          "$ref": "#/$defs/DoTeleport"
        },
        {
          "$ref": "#/$defs/DoToggle"
        },
        {
          "$ref": "#/$defs/DoOpen"
        },
        {
          "$ref": "#/$defs/DoFreeze"
        },
        {
          "$ref": "#/$defs/DoScore"
        },
        {
          "$ref": "#/$defs/DoCounter"
        },
        {
          "$ref": "#/$defs/DoHeal"
        },
        {
          "$ref": "#/$defs/DoHurt"
        },
        {
          "$ref": "#/$defs/DoWin"
        },
        {
          "$ref": "#/$defs/DoLose"
        },
        {
          "$ref": "#/$defs/DoSay"
        },
        {
          "$ref": "#/$defs/DoSound"
        },
        {
          "$ref": "#/$defs/DoShake"
        },
        {
          "$ref": "#/$defs/DoSetFrame"
        },
        {
          "$ref": "#/$defs/DoPush"
        }
      ]
    },
    "Script": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "start": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
          "type": "string"
        },
        "states": {
          "items": {
            "$ref": "#/$defs/ScriptState"
          },
          "maxItems": 8,
          "minItems": 1,
          "type": "array"
        },
        "gravity": {
          "default": false,
          "type": "boolean"
        },
        "solid": {
          "default": false,
          "type": "boolean"
        },
        "hazard": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "start",
        "states"
      ],
      "title": "Script",
      "type": "object"
    },
    "ScriptAfter": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "seconds": {
          "exclusiveMinimum": 0,
          "maximum": 600,
          "type": "number"
        },
        "goto": {
          "pattern": "^[a-z][a-z0-9_]{0,15}$",
