      "type": "object"
    },
    "DoTeleport": {
      "additionalProperties": false,
      "description": "Move the player to a cell (to) or onto an entity (target). Exactly one is set.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "teleport",
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellXY"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_]{1,40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "DoTeleport",
      "type": "object"
    },
    "DoToggle": {
      "additionalProperties": false,
      "description": "Show or hide an entity: a hidden entity is not drawn, not solid and does nothing.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "toggle",
          "type": "string"
        },
        "target": {
          "pattern": "^[A-Za-z0-9_]{1,40}$",
          "type": "string"
        },
        "to": {
          "default": "flip",
          "enum": [
            "on",
            "off",
            "flip"
          ],
          "type": "string"
        }
      },
      "required": [
        "kind",
        "target"
      ],
      "title": "DoToggle",
      "type": "object"
    },
    "DoWin": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
