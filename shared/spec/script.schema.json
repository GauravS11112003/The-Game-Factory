        },
        "name": {
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "n": {
          "default": 1,
          "maximum": 100,
          "minimum": -100,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "DoCounter",
      "type": "object"
    },
    "DoFlipGravity": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "flip_gravity",
