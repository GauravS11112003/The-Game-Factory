        },
        "kind": {
          "$ref": "#/$defs/FailureKind"
        },
        "need": {
          "type": "string"
        },
        "have": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to_object",
        "kind",
        "need",
        "have"
      ],
      "title": "Blocking",
      "type": "object"
    },
    "CellXY": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "Face": {
      "enum": [
