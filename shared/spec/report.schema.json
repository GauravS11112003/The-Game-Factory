        }
      },
      "required": [
        "id",
        "code",
        "severity"
      ],
      "title": "Flag",
      "type": "object"
    },
    "FlagCode": {
      "enum": [
        "unsolvable",
        "tight_window",
        "blind_jump",
        "leap_of_faith",
        "spawn_unsafe",
        "invisible_lethal",
        "softlock",
        "long_segment",
        "head_bonk",
        "unreachable_drawn",
