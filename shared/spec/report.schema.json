      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/FlagCode"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "frame": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "at": {
          "anyOf": [
            {
              "$ref": "#/$defs/CellXY"
            },
            {
              "type": "null"
            }
          ],
          "default": null
