{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://draw-a-level.dev/spec/v2/ink.schema.json",
  "$comment": "dal-level spec v1.0. GENERATED from vision/app/spec/ink.py by scripts/gen_contracts.py; do not edit.",
  "title": "ink",
  "description": "InkDoc: the only thing that crosses from seeing to building (PLAN_V2 §3.2).",
  "$ref": "#/$defs/InkDoc",
  "$defs": {
    "Archetype": {
      "enum": [
        "walker",
        "hopper",
        "flyer",
        "shooter",
        "chaser",
        "crusher"
      ],
      "type": "string"
    },
    "BCrumble": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "crumble",
          "type": "string"
        },
        "delay_s": {
          "default": 0.5,
          "type": "number"
        },
        "respawn_s": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BCrumble",
      "type": "object"
    },
    "BEnemy": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "enemy",
          "type": "string"
        },
        "archetype": {
          "$ref": "#/$defs/Archetype"
        },
        "spiky": {
          "default": false,
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/EnemyParams"
        }
      },
      "required": [
        "kind",
        "archetype"
      ],
      "title": "BEnemy",
      "type": "object"
    },
    "BFalling": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "falling",
          "type": "string"
        },
        "delay_s": {
          "default": 0.4,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFalling",
      "type": "object"
    },
    "BFirebar": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "firebar",
          "type": "string"
        },
        "balls": {
          "default": 4,
          "maximum": 6,
          "minimum": 3,
          "type": "integer"
        },
        "speed_deg_s": {
          "default": 90,
          "type": "number"
        },
        "phase": {
          "default": 0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFirebar",
      "type": "object"
    },
    "BFlipbook": {
      "additionalProperties": false,
      "description": "Changes through its drawn frames over time (seed, sprout, flower). The frame art is the library type's frames.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "flipbook",
          "type": "string"
        },
        "frames": {
          "default": 3,
          "maximum": 6,
          "minimum": 2,
          "type": "integer"
        },
        "frame_s": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "maximum": 600,
          "type": "number"
        },
        "loop": {
          "default": false,
          "type": "boolean"
        },
        "solid_from": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "collect_at": {
          "anyOf": [
            {
              "maximum": 5,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "item": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9 ]{0,15}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "BFlipbook",
      "type": "object"
    },
    "BMove": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "move",
          "type": "string"
        },
        "dir": {
          "$ref": "#/$defs/Dir4"
        },
        "cells": {
          "type": "number"
        },
        "speed": {
          "type": "number"
        },
        "mode": {
          "default": "pingpong",
          "enum": [
            "pingpong",
            "loop"
          ],
          "type": "string"
        },
        "wait_s": {
          "default": 0.3,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "dir",
        "cells",
        "speed"
      ],
      "title": "BMove",
      "type": "object"
    },
    "BNpc": {
      "additionalProperties": false,
      "description": "A character that talks: touching it shows its lines one by one in a speech bubble.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "npc",
          "type": "string"
        },
        "lines": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "type": "array"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 16,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "lines"
      ],
      "title": "BNpc",
      "type": "object"
    },
    "BPhysics": {
      "additionalProperties": false,
      "description": "A loose object that falls, slides, stacks and can be pushed. Boxes stay upright; balls roll.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "physics",
          "type": "string"
        },
        "shape": {
          "default": "box",
          "enum": [
            "box",
            "ball"
          ],
          "type": "string"
        },
        "material": {
          "$ref": "#/$defs/Material",
          "default": "wood"
        },
        "fixed": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPhysics",
      "type": "object"
    },
    "BPickup": {
      "additionalProperties": false,
      "description": "Something to collect. `item` names it for rules (\"star\"); `effect` is a ready-made rule fired on collect.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "pickup",
          "type": "string"
        },
        "item": {
          "default": "star",
          "pattern": "^[a-z][a-z0-9 ]{0,15}$",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/PickupEffect",
          "default": "none"
        },
        "seconds": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 5.0
        },
        "respawn_s": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 60,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPickup",
      "type": "object"
    },
    "BPortal": {
      "additionalProperties": false,
      "description": "Touching a portal moves the player to its partner: the other portal with the same `pair` label in the level\n(a lone portal does nothing).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "portal",
          "type": "string"
        },
        "pair": {
          "default": "a",
          "pattern": "^[a-z0-9]{1,8}$",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BPortal",
      "type": "object"
    },
    "BSaw": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "saw",
          "type": "string"
        },
        "radius": {
          "default": 1.0,
          "type": "number"
        },
        "dir": {
          "$ref": "#/$defs/Dir",
          "default": "none"
        },
        "cells": {
          "default": 0,
          "type": "number"
        },
        "speed": {
          "default": 3.0,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSaw",
      "type": "object"
    },
    "BScripted": {
      "additionalProperties": false,
      "description": "Runs the library type's script (a developer pack, app/spec/script.py).",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "scripted",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BScripted",
      "type": "object"
    },
    "BSpring": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "spring",
          "type": "string"
        },
        "dir": {
          "default": "up",
          "enum": [
            "up",
            "left",
            "right"
          ],
          "type": "string"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.4,
          "minimum": 0.6,
          "type": "number"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BSpring",
      "type": "object"
    },
    "BStatic": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "static",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "BStatic",
      "type": "object"
    },
    "BZone": {
      "additionalProperties": false,
      "description": "An area with an effect while the player is inside: wind and conveyor push toward `dir`, water slows and lets\nyou swim up, ice is slippery, low_gravity floats, slow halves speed. `strength` scales the effect.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "kind": {
          "const": "zone",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/ZoneEffect"
        },
        "dir": {
          "$ref": "#/$defs/Dir4",
          "default": "right"
        },
        "strength": {
          "default": 1.0,
          "maximum": 2.0,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "kind",
        "effect"
      ],
      "title": "BZone",
      "type": "object"
    },
    "Behavior": {
      "discriminator": {
        "mapping": {
          "crumble": "#/$defs/BCrumble",
          "enemy": "#/$defs/BEnemy",
          "falling": "#/$defs/BFalling",
          "firebar": "#/$defs/BFirebar",
          "flipbook": "#/$defs/BFlipbook",
          "move": "#/$defs/BMove",
          "npc": "#/$defs/BNpc",
          "physics": "#/$defs/BPhysics",
          "pickup": "#/$defs/BPickup",
          "portal": "#/$defs/BPortal",
          "saw": "#/$defs/BSaw",
          "scripted": "#/$defs/BScripted",
          "spring": "#/$defs/BSpring",
          "static": "#/$defs/BStatic",
          "zone": "#/$defs/BZone"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/BStatic"
        },
        {
          "$ref": "#/$defs/BEnemy"
        },
        {
          "$ref": "#/$defs/BMove"
        },
        {
          "$ref": "#/$defs/BSpring"
        },
        {
          "$ref": "#/$defs/BCrumble"
        },
        {
          "$ref": "#/$defs/BFalling"
        },
        {
          "$ref": "#/$defs/BSaw"
        },
        {
          "$ref": "#/$defs/BFirebar"
        },
        {
          "$ref": "#/$defs/BPortal"
        },
        {
          "$ref": "#/$defs/BZone"
        },
        {
          "$ref": "#/$defs/BPickup"
        },
        {
          "$ref": "#/$defs/BNpc"
        },
        {
          "$ref": "#/$defs/BPhysics"
        },
        {
          "$ref": "#/$defs/BFlipbook"
        },
        {
          "$ref": "#/$defs/BScripted"
        }
      ]
    },
    "CellXY": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "type": "array"
    },
    "CharacterInk": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "strokes": {
          "items": {
            "$ref": "#/$defs/InkStroke"
          },
          "type": "array"
        }
      },
      "required": [
        "strokes"
      ],
      "title": "CharacterInk",
      "type": "object"
    },
    "ComponentFeatures": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "fill": {
          "type": "number"
        },
        "circ": {
          "type": "number"
        },
        "straight": {
          "type": "number"
        },
        "zigN": {
          "type": "number"
        },
        "zigAmp": {
          "type": "number"
        },
        "aspect": {
          "type": "number"
        },
        "holes": {
          "type": "integer"
        },
        "w": {
          "type": "number"
        },
        "corners": {
          "type": "integer"
        },
        "spokes": {
          "type": "integer"
        },
        "bumps": {
          "type": "integer"
        },
        "is_dot": {
          "type": "boolean"
        }
      },
      "required": [
        "fill",
        "circ",
        "straight",
        "zigN",
        "zigAmp",
        "aspect",
        "holes",
        "w",
        "corners",
        "spokes",
        "bumps",
        "is_dot"
      ],
      "title": "ComponentFeatures",
      "type": "object"
    },
    "Dir": {
      "enum": [
        "up",
        "down",
        "left",
        "right",
        "none"
      ],
      "type": "string"
    },
    "Dir4": {
      "enum": [
        "up",
        "down",
        "left",
        "right"
      ],
      "type": "string"
    },
    "EnemyParams": {
      "additionalProperties": false,
      "description": "Archetype parameters (§5.7); every field optional, defaults live in core/params.ts.",
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ledge_aware": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interval": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "forward": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "pattern": {
          "anyOf": [
            {
              "enum": [
                "hover",
                "horizontal",
                "vertical",
                "circle"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "range": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "radius": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "period": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "facing": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right",
                "toward_player"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "blob_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "sight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warn": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rise_speed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "EnemyParams",
      "type": "object"
    },
    "InkColor": {
      "enum": [
        "black",
        "red",
        "green",
        "blue",
        "pencil",
        "draft"
      ],
      "type": "string"
    },
    "InkComponent": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "minimum": 1,
          "type": "integer"
        },
        "color": {
          "$ref": "#/$defs/InkColor"
        },
        "stroke_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "bbox": {
          "$ref": "#/$defs/RectCells"
        },
        "area": {
          "type": "number"
        },
        "f": {
          "$ref": "#/$defs/ComponentFeatures"
        }
      },
      "required": [
        "id",
        "color",
        "stroke_ids",
        "bbox",
        "area",
        "f"
      ],
      "title": "InkComponent",
      "type": "object"
    },
    "InkDoc": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "v": {
          "const": 2,
          "type": "integer"
        },
        "source": {
          "enum": [
            "canvas",
            "paper",
            "prompt",
            "migrated"
          ],
          "type": "string"
        },
        "world": {
          "$ref": "#/$defs/InkWorld"
        },
        "strokes": {
          "items": {
            "$ref": "#/$defs/InkStroke"
          },
          "type": "array"
        },
        "components": {
          "items": {
            "$ref": "#/$defs/InkComponent"
          },
          "type": "array"
        },
        "character": {
          "anyOf": [
            {
              "$ref": "#/$defs/CharacterInk"
            },
            {
              "type": "null"
            }
          ]
        },
        "typed_rules": {
          "items": {
            "$ref": "#/$defs/TypedRule"
          },
          "type": "array"
        },
        "rules_ink": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sheets": {
          "items": {
            "$ref": "#/$defs/SheetInfo"
          },
          "type": "array"
        },
        "noise": {
          "$ref": "#/$defs/NoiseInfo"
        },
        "parent": {
          "anyOf": [
            {
              "$ref": "#/$defs/ParentRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "v",
        "source",
        "world",
        "strokes",
        "components",
        "character",
        "typed_rules",
        "rules_ink",
        "sheets",
        "noise",
        "parent"
      ],
      "title": "InkDoc",
      "type": "object"
    },
    "InkStroke": {
      "additionalProperties": false,
      "patternProperties": {
        "^x_": {}
      },
      "properties": {
        "id": {
          "type": "string"
        },
        "color": {
          "$ref": "#/$defs/InkColor"
        },
        "kind": {
          "enum": [
            "line",
            "dot",
            "blob"
          ],
          "type": "string"
        },
        "pts": {
          "items": {
            "$ref": "#/$defs/CellXY"
          },
          "type": "array"
        },
        "w": {
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "closed": {
          "type": "boolean"
        },
        "sheet": {
          "minimum": 0,
          "type": "integer"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "stamp": {
          "anyOf": [
            {
              "$ref": "#/$defs/StampKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/Role"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/Behavior"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "lib": {
          "anyOf": [
            {
              "$ref": "#/$defs/LibRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "t": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "color",
        "kind",
        "pts",
        "w",
        "closed",
        "sheet",
        "origin"
