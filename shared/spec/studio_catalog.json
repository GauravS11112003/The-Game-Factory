{
  "$comment": "draw.play Studio catalog (docs/v6/CONTRACTS_V6.md §3). The one list of behaviours, rule events, rule actions, keys and archetypes. The runtime implements every entry, the inspector renders its params, the copilot may only use what is here. Param types: number, int, bool, string, choice (options), key, target (self|other|player1|player2|an object id|a tag), object (an object id), template (an object id with template:true, or 'default'), tag, counter, vec.",
  "version": 1,
  "keys": {
    "names": ["left", "right", "up", "down", "space", "action", "action2", "w", "a", "s", "d", "f", "g", "shift", "enter", "any"],
    "schemes": {
      "single": {"left": ["ArrowLeft", "KeyA"], "right": ["ArrowRight", "KeyD"], "up": ["ArrowUp", "KeyW"], "down": ["ArrowDown", "KeyS"], "jump": ["ArrowUp", "KeyW", "Space"], "action": ["KeyE", "Enter"], "action2": ["KeyQ", "ShiftLeft"], "space": ["Space"]},
      "player1": {"left": ["KeyA"], "right": ["KeyD"], "up": ["KeyW"], "down": ["KeyS"], "jump": ["KeyW"], "action": ["KeyF"], "action2": ["KeyG"], "space": ["Space"]},
      "player2": {"left": ["ArrowLeft"], "right": ["ArrowRight"], "up": ["ArrowUp"], "down": ["ArrowDown"], "jump": ["ArrowUp"], "action": ["KeyL", "Enter"], "action2": ["KeyK"], "space": ["ShiftRight"]}
    },
    "$comment_schemes": "An object with player 1 or 2 uses that player's scheme when world.players is 2, and the 'single' scheme otherwise. Rule keys 'left'…'action2' follow the same mapping for the object the rule belongs to; w/a/s/d/f/g/shift/enter/space are raw keys."
  },
  "behaviors": [
    {"type": "platformer", "label": "Run and jump", "group": "control", "help": "Left and right to run, jump to jump. Needs a dynamic body.",
     "params": [
       {"name": "speed", "type": "number", "default": 280, "min": 40, "max": 1200, "label": "Run speed"},
       {"name": "jump", "type": "number", "default": 640, "min": 0, "max": 2000, "label": "Jump power"},
       {"name": "double_jump", "type": "bool", "default": false, "label": "Double jump"},
       {"name": "air_control", "type": "number", "default": 0.8, "min": 0, "max": 1, "label": "Air control"},
       {"name": "auto_run", "type": "number", "default": 0, "min": -1200, "max": 1200, "label": "Always runs at (px/s, 0 = off)"}]},
    {"type": "move_keys", "label": "Move with keys", "group": "control", "help": "Moves straight with the arrow keys (top-down games, menus, paddles).",
     "params": [
       {"name": "speed", "type": "number", "default": 260, "min": 20, "max": 1500, "label": "Speed"},
       {"name": "axes", "type": "choice", "options": ["xy", "x", "y"], "default": "xy", "label": "Directions"},
       {"name": "face_move", "type": "bool", "default": false, "label": "Turn to face where it moves"}]},
    {"type": "car", "label": "Drive", "group": "control", "help": "Right to drive, left to brake and reverse. Drives its wheel joints; tilts in the air.",
     "params": [
       {"name": "power", "type": "number", "default": 0.6, "min": 0.05, "max": 3, "label": "Engine power"},
       {"name": "max_speed", "type": "number", "default": 900, "min": 50, "max": 4000, "label": "Top speed"},
       {"name": "tilt", "type": "number", "default": 0.5, "min": 0, "max": 3, "label": "Air tilt"},
       {"name": "fuel_counter", "type": "counter", "default": "", "label": "Uses fuel from counter (empty = no fuel)"},
       {"name": "distance_counter", "type": "counter", "default": "distance", "label": "Counts metres driven in game counter (empty = off)"}]},
    {"type": "thrust_ship", "label": "Fly a ship", "group": "control", "help": "Up to thrust, left and right to turn (asteroids style).",
     "params": [
       {"name": "thrust", "type": "number", "default": 600, "min": 20, "max": 4000, "label": "Thrust"},
       {"name": "turn", "type": "number", "default": 220, "min": 10, "max": 1080, "label": "Turn speed (°/s)"},
       {"name": "max_speed", "type": "number", "default": 700, "min": 50, "max": 4000, "label": "Top speed"}]},
    {"type": "launcher", "label": "Pull and launch", "group": "control", "help": "Drag it back with the mouse or a finger and let go, like a slingshot.",
     "params": [
       {"name": "power", "type": "number", "default": 1, "min": 0.1, "max": 5, "label": "Power"},
       {"name": "max_pull", "type": "number", "default": 180, "min": 20, "max": 800, "label": "Longest pull (px)"},
       {"name": "shots_counter", "type": "counter", "default": "", "label": "Uses shots from counter"},
       {"name": "out_of_shots", "type": "choice", "options": ["lose", "nothing"], "default": "lose", "label": "When the last shot has landed"}]},
    {"type": "draggable", "label": "Drag with the mouse", "group": "control", "help": "Pick it up and move it (puzzles, sorting games).", "params": []},
    {"type": "shooter", "label": "Shoot", "group": "action", "help": "Fires copies of a projectile.",
     "params": [
       {"name": "projectile", "type": "template", "default": "default", "label": "Projectile"},
       {"name": "key", "type": "choice", "options": ["action", "space", "action2", "auto", "click"], "default": "space", "label": "Fire with"},
       {"name": "rate", "type": "number", "default": 4, "min": 0.2, "max": 30, "label": "Shots per second"},
       {"name": "speed", "type": "number", "default": 800, "min": 50, "max": 4000, "label": "Bullet speed"},
       {"name": "direction", "type": "choice", "options": ["facing", "up", "down", "left", "right", "mouse", "player"], "default": "facing", "label": "Direction"},
       {"name": "damage", "type": "number", "default": 1, "min": 0, "max": 100, "label": "Damage"},
       {"name": "spread", "type": "number", "default": 0, "min": 0, "max": 90, "label": "Spread (°)"},
       {"name": "lifetime", "type": "number", "default": 2, "min": 0.1, "max": 20, "label": "Bullet lifetime (s)"}]},
    {"type": "melee", "label": "Punch / swing", "group": "action", "help": "Hits whatever is just in front of it.",
     "params": [
       {"name": "key", "type": "choice", "options": ["action", "action2", "space"], "default": "action", "label": "Attack with"},
       {"name": "damage", "type": "number", "default": 1, "min": 0, "max": 100, "label": "Damage"},
       {"name": "range", "type": "number", "default": 60, "min": 5, "max": 600, "label": "Reach (px)"},
       {"name": "knockback", "type": "number", "default": 450, "min": 0, "max": 4000, "label": "Knockback"},
       {"name": "cooldown", "type": "number", "default": 0.4, "min": 0.05, "max": 10, "label": "Cooldown (s)"}]},
    {"type": "health", "label": "Health", "group": "stats", "help": "Keeps a health counter; damage lowers it.",
     "params": [
       {"name": "max", "type": "number", "default": 3, "min": 1, "max": 10000, "label": "Max health"},
       {"name": "invulnerable", "type": "number", "default": 0.6, "min": 0, "max": 10, "label": "Safe time after a hit (s)"},
       {"name": "on_zero", "type": "choice", "options": ["destroy", "lose", "respawn", "nothing"], "default": "destroy", "label": "At zero health"},
       {"name": "bar", "type": "bool", "default": false, "label": "Show a bar above it"}]},
    {"type": "damage", "label": "Hurts on touch", "group": "stats", "help": "Takes health from what it touches.",
     "params": [
       {"name": "amount", "type": "number", "default": 1, "min": 0, "max": 10000, "label": "Damage"},
       {"name": "to", "type": "target", "default": "player", "label": "Hurts (tag or object)"},
       {"name": "knockback", "type": "number", "default": 350, "min": 0, "max": 4000, "label": "Knockback"},
       {"name": "destroy_self", "type": "bool", "default": false, "label": "Breaks after hitting"},
       {"name": "min_speed", "type": "number", "default": 0, "min": 0, "max": 4000, "label": "Only when hitting faster than (px/s, 0 = any touch)"}]},
    {"type": "pickup", "label": "Pick up", "group": "stats", "help": "Touching it gives an item (adds to a counter) and it disappears.",
     "params": [
       {"name": "item", "type": "counter", "default": "coins", "label": "Gives"},
       {"name": "amount", "type": "number", "default": 1, "min": -10000, "max": 10000, "label": "How many"},
       {"name": "to", "type": "target", "default": "player", "label": "Picked up by"},
       {"name": "respawn", "type": "number", "default": 0, "min": 0, "max": 600, "label": "Comes back after (s, 0 = never)"}]},
    {"type": "spawner", "label": "Spawner", "group": "world", "help": "Makes copies of a template every few seconds.",
     "params": [
       {"name": "template", "type": "template", "default": "", "label": "Makes copies of"},
       {"name": "every", "type": "number", "default": 2, "min": 0.05, "max": 600, "label": "Every (s)"},
       {"name": "max", "type": "int", "default": 12, "min": 1, "max": 200, "label": "At most at once"},
       {"name": "area", "type": "choice", "options": ["self", "top", "bottom", "left", "right", "screen"], "default": "self", "label": "Where"},
       {"name": "velocity", "type": "vec", "default": [0, 0], "label": "Starting velocity"},
       {"name": "jitter", "type": "number", "default": 0, "min": 0, "max": 2000, "label": "Random spread (px)"}]},
    {"type": "follow", "label": "Follow", "group": "move", "help": "Moves toward a target.",
     "params": [
       {"name": "target", "type": "target", "default": "player", "label": "Follows"},
       {"name": "speed", "type": "number", "default": 150, "min": 5, "max": 3000, "label": "Speed"},
       {"name": "axes", "type": "choice", "options": ["xy", "x", "y"], "default": "x", "label": "Directions"},
       {"name": "range", "type": "number", "default": 0, "min": 0, "max": 20000, "label": "Only within (px, 0 = always)"}]},
    {"type": "patrol", "label": "Patrol", "group": "move", "help": "Goes back and forth.",
     "params": [
       {"name": "range", "type": "number", "default": 200, "min": 5, "max": 20000, "label": "Distance (px)"},
       {"name": "speed", "type": "number", "default": 120, "min": 5, "max": 3000, "label": "Speed"},
       {"name": "axis", "type": "choice", "options": ["x", "y"], "default": "x", "label": "Direction"}]},
    {"type": "rotate", "label": "Spin", "group": "move", "params": [{"name": "speed", "type": "number", "default": 90, "min": -2000, "max": 2000, "label": "Degrees per second"}]},
    {"type": "oscillate", "label": "Bob / sway", "group": "move", "help": "Moves smoothly back and forth (moving platforms).",
     "params": [
       {"name": "axis", "type": "choice", "options": ["x", "y"], "default": "y", "label": "Direction"},
       {"name": "range", "type": "number", "default": 80, "min": 1, "max": 20000, "label": "Distance (px)"},
       {"name": "period", "type": "number", "default": 2, "min": 0.1, "max": 120, "label": "Seconds per trip"}]},
    {"type": "bounce_pad", "label": "Bounce pad", "group": "world", "help": "Launches what lands on it.", "params": [{"name": "power", "type": "number", "default": 1000, "min": 50, "max": 6000, "label": "Power"}]},
    {"type": "conveyor", "label": "Conveyor", "group": "world", "params": [{"name": "speed", "type": "number", "default": 150, "min": -3000, "max": 3000, "label": "Speed"}]},
    {"type": "goal", "label": "Goal", "group": "world", "help": "Touching it wins the level (or goes to the next scene).",
     "params": [{"name": "by", "type": "target", "default": "player", "label": "Reached by"}, {"name": "then", "type": "choice", "options": ["next_scene", "win"], "default": "next_scene", "label": "Then"}]},
    {"type": "hazard", "label": "Deadly", "group": "world", "help": "Touching it costs a life (or all health).", "params": [{"name": "to", "type": "target", "default": "player", "label": "Deadly to"}]},
    {"type": "checkpoint", "label": "Checkpoint", "group": "world", "help": "The player respawns here after touching it.", "params": []},
    {"type": "lifetime", "label": "Disappears after", "group": "world", "params": [{"name": "seconds", "type": "number", "default": 3, "min": 0.05, "max": 600, "label": "Seconds"}]},
    {"type": "wrap", "label": "Wrap around edges", "group": "world", "help": "Leaving one side comes back on the other.", "params": []},
    {"type": "ai_fighter", "label": "Computer fighter", "group": "control", "help": "Walks to the target and attacks with its melee or shooter.",
     "params": [{"name": "target", "type": "target", "default": "player1", "label": "Fights"}, {"name": "skill", "type": "number", "default": 0.5, "min": 0, "max": 1, "label": "Skill"}]},
    {"type": "float", "label": "Float gently", "group": "move", "help": "A small idle bob (decoration, pickups).", "params": [{"name": "amplitude", "type": "number", "default": 6, "min": 0, "max": 200}, {"name": "period", "type": "number", "default": 2, "min": 0.1, "max": 60}]}
  ],
