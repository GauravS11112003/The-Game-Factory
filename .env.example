# Copy to .env (same folder) and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
DAL_SONNET_MODEL=claude-sonnet-5-5
# Imagine creates a Sonnet SVG art pack only when Better graphics is selected.
# Uses ANTHROPIC_API_KEY and DAL_SONNET_MODEL; no separate image credentials.
# Set 0 to disable the extra Imagine art pass globally.
DAL_IMAGINE_ART=1
# Load this file when starting the API: uvicorn app.main:app --env-file ../.env

# Simple Auth0 accounts (all four credentials are required to enable).
# Register a Regular Web Application, with AUTH0_BASE_URL/api/auth/callback
# as an Allowed Callback URL and AUTH0_BASE_URL as an Allowed Logout URL.
# No Auth0 values belong in the frontend bundle.
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SESSION_SECRET=
AUTH0_BASE_URL=http://localhost:5173

# --- v3 creative ("Bring to life"), all optional -----------------------------------------------------------------
# Adobe Firefly Services: https://developer.adobe.com/console → Create project → Add API → "Firefly - Firefly
# Services" → OAuth Server-to-Server credential; copy its Client ID and Client Secret here. With both set the art
# provider is Firefly; without them Claude draws SVG sprites (needs ANTHROPIC_API_KEY); with neither the kid's ink stays.
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
DAL_ART_PROVIDER=auto        # auto | firefly | claude-svg | none
DAL_ART_BUDGET_USD=5         # daily cap for art (Claude SVG cost; each Firefly image counts DAL_FIREFLY_USD_PER_IMAGE)
# DAL_FIREFLY_USD_PER_IMAGE=0.04
# DAL_FIREFLY_REMOVE_BG=0    # 1: Photoshop API remove-background v2 on Firefly output (default: local cutout)
# DAL_FIREFLY_SYNC=0         # 1: POST /v3/images/generate instead of generate-async + status polling
# DAL_FIREFLY_MODEL=         # x-model-version header (image3, image4_standard, ...); empty: Firefly's default

# --- Two-player races through Photon Spectrum (docs/imessage.md) ----------------------------------------------
# Public HTTPS web/API origin; omit for local browser races.
DAL_PUBLIC_URL=
# Internal API address used by the separate messaging service.
DAL_API_URL=http://127.0.0.1:8000
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Separate random server credential, shared by the API and messaging service (at least 32 random bytes).
DAL_SPECTRUM_SERVICE_SECRET=
# Provisioned Photon number. Enables the lobby's "Start a race in iMessage" action.
DAL_SPECTRUM_NUMBER=
# DAL_SPECTRUM_DATA_DIR=../vision/data/messaging
# card (default): Spectrum game card; link: ordinary URL for browser play.
DAL_SPECTRUM_DELIVERY=card
