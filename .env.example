# Copy to .env (same folder) and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=

# --- v3 creative ("Bring to life"), all optional -----------------------------------------------------------------
# Adobe Firefly Services: https://developer.adobe.com/console → Create project → Add API → "Firefly - Firefly
# Services" → OAuth Server-to-Server credential; copy its Client ID and Client Secret here. With both set the art
# provider is Firefly; without them Claude draws SVG sprites (needs ANTHROPIC_API_KEY); with neither the kid's ink stays.
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
DAL_ART_PROVIDER=auto        # auto | firefly | claude-svg | none
DAL_ART_BUDGET_USD=5         # daily cap for art (Claude SVG cost; each Firefly image counts DAL_FIREFLY_USD_PER_IMAGE)
# DAL_FIREFLY_USD_PER_IMAGE=0.04
# DAL_FIREFLY_REMOVE_BG=0    # 1: Photoshop API remove-background v2 on Firefly output (default: local cutout)
# DAL_FIREFLY_SYNC=0         # 1: POST /v3/images/generate instead of generate-async + status polling
# DAL_FIREFLY_MODEL=         # x-model-version header (image3, image4_standard, ...); empty: Firefly's default
