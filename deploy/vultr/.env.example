# Copy to .env in this directory ON THE SERVER. Never commit real credentials.
# A domain name only: no https://, slash, or path.
APP_DOMAIN=play.your-domain.com

# Add these before enabling the imessage profile.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Generate with: openssl rand -hex 32
DAL_SPECTRUM_SERVICE_SECRET=
# A number supplied by Photon for your project/test recipient, with country code.
# Leave blank if your shared-pool setup has no single public number.
DAL_SPECTRUM_NUMBER=
# card opens in Messages through Spectrum; link sends a normal browser invitation.
DAL_SPECTRUM_DELIVERY=card

# Optional: existing levels/races work without model or Adobe credentials.
ANTHROPIC_API_KEY=
DAL_SONNET_MODEL=claude-sonnet-5-5
DAL_DAILY_BUDGET_USD=10
DAL_DRAFT_BUDGET_USD=0.40
DAL_CORE_WORKERS=2
FIREFLY_CLIENT_ID=
FIREFLY_CLIENT_SECRET=
DAL_ART_PROVIDER=auto
DAL_ART_BUDGET_USD=5
